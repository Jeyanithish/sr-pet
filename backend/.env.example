# Database
DB_URL=jdbc:postgresql://localhost:5432/sr_pet_world
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security (minimum 32 characters for HS256)
JWT_SECRET=replace-with-a-strong-random-64-char-secret-key
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AWS S3 (leave AWS_S3_BUCKET blank in local dev to use local filesystem fallback)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
LOCAL_UPLOAD_DIR=uploads
